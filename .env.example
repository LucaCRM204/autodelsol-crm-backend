# ============================================
# AUTO DEL SOL CRM — Variables de entorno (backend)
# Copiar a .env y completar con valores reales.
# ============================================

# --- Servidor ---
PORT=3001
NODE_ENV=development

# --- Base de datos MySQL ---
# Si DATABASE_URL está seteada, se usa esa (típico en Railway).
# Si no, se arma la conexión con las variables sueltas de abajo.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=autodelsol_crm

# --- Auth ---
JWT_SECRET=cambiar_esto_por_algo_largo_y_random
JWT_EXPIRES_IN=7d

# --- CORS ---
# Dominios del frontend separados por coma, ej:
# https://crm.autodelsol.com.ar,https://autodelsol.vercel.app
CORS_ORIGIN=

# --- Webhooks de entrada (bot WhatsApp / Zapier) ---
# Formato: proveedor:clave;proveedor2:clave2
# Ej: whatsapp-bot:abc123;zapier-formularios:xyz789
LEAD_API_KEYS=
